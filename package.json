    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.4",
    "playwright": "^1.62.0",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
